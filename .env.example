# Copy to .env.local and fill in. Never commit .env.local.

# OAuth 2.0 "Web application" client ID from Google Cloud Console
# (APIs & Services > Credentials). Under "Authorized JavaScript origins" add every
# origin the app runs on, e.g. http://localhost, http://localhost:5173 and the deployed site.
# Leave empty to hide Google sign-in; file upload still works.
VITE_GOOGLE_CLIENT_ID=
